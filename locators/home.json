{
   "Products": {
    "productList": {
      "type": "xpath",
      "value": "//div[@class='features_items']"
    },
    "productName": {
      "type": "xpath",
      "value": "//div[@class='features_items']//h2"
    },
    "addToCartButton": {
      "type": "xpath",
      "value": "//div[@class='features_items']//a[text()='Add to cart']"
    },
    "viewCartButton": {
